{
  "name": "c182-flight-planner",
  "version": "16.48.0",
  "description": "VFR flight planner for Cessna 182T, built to one self-contained HTML file (ground planning only)",
  "scripts": {
    "serve": "node tools/build.mjs && node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck --silent && npm run build --silent && node test.js",
    "build:aip": "node tools/build-aip.mjs",
    "build:border": "node tools/build-border.mjs",
    "build:vac": "node tools/build-vac.mjs",
    "verify:hover": "node tools/verify-airspace-hover.mjs",
    "verify:fixes": "node tools/verify-fixes.mjs",
    "verify:leg": "node tools/verify-leg-panel.mjs",
    "verify:ofp": "node tools/verify-ofp-print.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "geographiclib-geodesic": "^2.2.0",
    "magvar": "^2.2.0"
  }
}
