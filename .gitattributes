# Keep the working tree LF on every platform.
#
# Git on Windows checks source out as CRLF by default (core.autocrlf), which
# silently broke tools/build.mjs: its @BUNDLE marker regex matched "\n" but
# the cloned file had "\r\n". A ZIP download preserves LF, so the failure
# only appeared once the repo was cloned rather than downloaded.
* text=auto eol=lf

# Windows batch files are the exception: cmd.exe is happiest with CRLF, and
# LF can break labels and goto in some shells.
*.cmd text eol=crlf

# Never let git rewrite bytes inside these.
*.png binary
*.jpg binary
*.pdf binary
*.ico binary
